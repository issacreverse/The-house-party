    m_MinSize: 3
    m_MaxSize: 50
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "You are a Detective seeking Monsters during this Halloween Party, and
    it's your job to investigate through observation and interaction!\r\n\r\nLook
    around for anyone you find suspicious. If you're certain you see a monster, hold
    the right mouse button to aim, then the left mouse button to fire a tag at the
    Partygoer!\r\n\r\nIf you're not sure about a monster, you can interact with them
    by pressing the E key! Once you do, they'll say something that will clue you
    in on their alignment!\r\n\r\nOnce you've used all of your tags, you'll exit
    the party, and you'll see how well you did! Tag every monster and you'll win!
    However if you get any wrong, it will be curtains for you, so make sure to observe
    keenly before making a decision! \r\n\r\nGood Luck Detective!\r\n"
